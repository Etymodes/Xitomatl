{
  "name": "xitomatl",
  "private": true,
  "version": "0.1.0",
  "productName": "时茄 Xitomatl",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test src/core/*.test.ts src/*.test.ts",
    "desktop:dev": "node electron/dev.mjs",
    "desktop:start": "npm run build && electron .",
    "desktop:package:win": "npm run build && electron-builder --win portable --x64 --publish never"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "com.etymodes.xitomatl",
    "productName": "时茄 Xitomatl",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "portable"
      ],
      "artifactName": "Xitomatl-${version}-win-${arch}-portable.${ext}"
    }
  }
}
